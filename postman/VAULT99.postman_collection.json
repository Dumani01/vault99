      "item": [
        {
          "name": "Crear marcas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/marcas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Marca Postman\",\n  \"descripcion\": \"Demostración\",\n  \"pais_origen\": \"Costa Rica\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"marcas_id\", pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
